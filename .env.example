# Discord Alerts (apna webhook URL .env mein daalo, yahan nahi)
DISCORD_WEBHOOK_URL=

# Ollama (local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_QUICK_MODEL=llama3.2:3b
OLLAMA_DEEP_MODEL=llama3.2:3b

# Trading defaults
ACCOUNT_EQUITY=10000
MAX_RISK_PER_TRADE=1.0
MAX_PORTFOLIO_HEAT=6.0
